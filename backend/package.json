{
  "description": "Backend tro ly AI dat lich kham — NestJS + TypeScript + LangChain (OpenAI) + TypeORM",
  "name": "bookingcare-ai-backend",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:tsx": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "data:prepare": "tsx scripts/prepare-data.ts",
    "data:index": "tsx scripts/build-index.ts",
    "db:seed": "tsx scripts/seed-db.ts",
    "test:tools": "tsx scripts/test-tools.ts"
  },
  "version": "0.1.0",
  "dependencies": {
    "@langchain/anthropic": "^1.6.5",
    "@langchain/core": "^1.4.1",
    "@langchain/openai": "^1.8.4",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/typeorm": "^12.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "langchain": "^1.6.6",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

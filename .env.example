# --- LLM: chon 1 trong 2 nha cung cap, doi bang cau hinh (khong sua code) ---
# openai: dung OPENAI_API_KEY; anthropic: dung ANTHROPIC_API_KEY
LLM_PROVIDER=openai
# Ten model tuy y cua provider da chon (vi du: gpt-5.4 / claude-haiku-4-5)
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Server ---
PORT=3001

# --- Database (TypeORM) ---
# Mac dinh sqlite (file backend/bookingcare.db). Doi sang MySQL chi bang env:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=
# DB_DATABASE=bookingcare_ai
DB_TYPE=sqlite
